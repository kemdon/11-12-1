---
export interface Props {
  title?: string;
  body?: string;
  image?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = '先说清你的团队问题，再决定怎么学',
  body = '提交团队人数、所属行业和当前最想解决的问题，我们先一起判断适合胖东来研学、标杆企业研学，还是落地课与定制课程。',
  image = '/images/cta-wide.webp',
  primaryLabel = '沟通团队需求',
  primaryHref = '/contact',
  secondaryLabel = '查看课程中心',
  secondaryHref = '/courses',
} = Astro.props;
---

<section class="cta-band">
  <img class="cta-band__img" src={image} alt="" aria-hidden="true" loading="lazy" />
  <div class="cta-band__shade" aria-hidden="true"></div>
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <span class="cta-band__kicker">NEXT STEP · 从一次沟通开始</span>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primaryHref} class="btn btn--gold">{primaryLabel} →</a>
      <a href={secondaryHref} class="btn btn--outline">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; background: var(--navy-950); }
  .cta-band__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    opacity: .32;
  }
  .cta-band__shade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(90,36,8,.93) 0%, rgba(90,36,8,.8) 52%, rgba(90,36,8,.5) 100%);
  }
  .cta-band__inner {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 40px;
    padding-top: 72px; padding-bottom: 76px;
  }
  .cta-band__text { max-width: 700px; }
  .cta-band__kicker { color: var(--gold-light); font-size: 12px; font-weight: 700; letter-spacing: .2em; }
  .cta-band h2 { color: #fff; font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 14px 0 14px; }
  .cta-band p { color: rgba(255,255,255,.75); font-size: 15.5px; line-height: 1.9; }
  .cta-band__actions { display: flex; flex-direction: column; gap: 14px; flex: none; min-width: 210px; }
  .cta-band__actions .btn { width: 100%; }

  @media (max-width: 900px) {
    .cta-band__inner { flex-direction: column; align-items: flex-start; padding-top: 56px; padding-bottom: 60px; }
    .cta-band__actions { flex-direction: row; width: 100%; min-width: 0; flex-wrap: wrap; }
    .cta-band__actions .btn { width: auto; flex: 1 1 180px; }
  }
  @media (max-width: 480px) {
    .cta-band__actions { flex-direction: column; }
    .cta-band__actions .btn { width: 100%; }
  }
</style>
