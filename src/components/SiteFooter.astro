---
import { site, navItems } from '../data/site';

const year = new Date().getFullYear();
const quickLinks = [
  { label: '胖东来研学', href: '/yanxue' },
  { label: '标杆企业研学', href: '/youxue' },
  { label: '课程中心', href: '/courses' },
  { label: '课程排期', href: '/schedule' },
  { label: '研学案例', href: '/cases' },
  { label: '讲师团队', href: '/teachers' },
  { label: '研学动态', href: '/news' },
  { label: '研学指南', href: '/guide' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-chip"><img src="/images/logo.webp" alt="商盛源 Logo" width="54" height="54" loading="lazy" /></span>
          <div>
            <strong>{site.name}</strong>
            <small>{site.tagline}</small>
          </div>
        </div>
        <p>{site.description}</p>
        <div class="footer-belief">{site.belief}</div>
      </div>

      <div class="footer-col">
        <h4>网站导航</h4>
        <ul>
          {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <h4>课程与服务</h4>
        <ul>
          {quickLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col footer-contact">
        <h4>咨询与联系</h4>
        <p>微信公众号 <strong>{site.wechat}</strong></p>
        <p>在公众号后台留言，或联系课程助教沟通团队需求。</p>
        <p>所在地：{site.region}　·　{site.group}</p>
        <a href="/contact" class="footer-btn">沟通团队需求 →</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.copyright}</span>
      <span>{site.sourceNote}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0a1d36;
    color: rgba(255, 255, 255, .7);
    border-top: 3px solid var(--gold);
    padding-top: 68px;
    background-image: radial-gradient(circle at 8% 0%, rgba(229,119,40,.1), transparent 34%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.55fr .8fr .8fr 1.25fr;
    gap: 48px;
    padding-bottom: 54px;
  }

  .footer-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .footer-logo-chip {
    width: 60px; height: 60px;
    display: grid; place-items: center;
    border-radius: 8px;
    background: #fff8f2;
    border: 1px solid rgba(229,119,40,.4);
    padding: 4px;
    flex: none;
  }
  .footer-logo-chip img { width: 100%; height: 100%; object-fit: contain; }
  .footer-logo strong { display: block; color: #fff; font-size: 21px; letter-spacing: .1em; line-height: 1.2; }
  .footer-logo small { display: block; color: var(--gold-light); font-size: 10.5px; letter-spacing: .04em; margin-top: 4px; }

  .footer-brand p { font-size: 14px; line-height: 1.95; color: rgba(255,255,255,.62); max-width: 420px; }
  .footer-belief {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.12);
    color: var(--gold-light);
    font-size: 13px;
    letter-spacing: .04em;
  }

  .footer-col h4 {
    color: #fff;
    font-size: 15px;
    margin-bottom: 20px;
    letter-spacing: .04em;
  }
  .footer-col ul { display: grid; gap: 12px; }
  .footer-col a { color: rgba(255,255,255,.66); font-size: 14px; }
  .footer-col a:hover { color: var(--gold-light); padding-left: 4px; }

  .footer-contact p { font-size: 13.5px; line-height: 1.9; color: rgba(255,255,255,.62); margin-bottom: 8px; }
  .footer-contact strong { color: var(--gold-light); }
  .footer-btn {
    display: inline-block;
    margin-top: 14px;
    padding: 10px 20px;
    border: 1px solid var(--gold);
    border-radius: 6px;
    color: var(--gold-light) !important;
    font-size: 13.5px !important;
    font-weight: 700;
  }
  .footer-btn:hover { background: var(--gold); color: var(--navy-950) !important; padding-left: 20px !important; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding: 22px 0 26px;
    border-top: 1px solid rgba(255,255,255,.12);
    font-size: 12.5px;
    color: rgba(255,255,255,.45);
  }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; }
  }
  @media (max-width: 600px) {
    .site-footer { padding-top: 50px; }
    .footer-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; padding-bottom: 36px; }
    .footer-bottom { flex-direction: column; }
  }
</style>
