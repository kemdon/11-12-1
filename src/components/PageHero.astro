---
export interface Props {
  kicker: string;
  title: string;
  body: string;
  crumb: string;
  image?: string;
}
const { kicker, title, body, crumb, image } = Astro.props;
---

<section class="page-hero">
  {image && <img class="page-hero__img" src={image} alt="" aria-hidden="true" />}
  <div class="page-hero__shade" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div class="crumb"><a href="/">首页</a><span>/</span><span>{crumb}</span></div>
    <span class="page-hero__kicker">{kicker}</span>
    <h1>{title}</h1>
    <p>{body}</p>
    <div class="page-hero__actions"><slot /></div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(125deg, #0a1d36 0%, #123f70 62%, #1b4a7a 100%);
    padding: 64px 0 72px;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }
  .page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 45%;
    opacity: .28;
  }
  .page-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(10,29,54,.94) 0%, rgba(10,29,54,.76) 48%, rgba(10,29,54,.35) 100%);
  }
  .page-hero__inner { position: relative; z-index: 1; }
  .page-hero__kicker {
    display: inline-block;
    margin-top: 26px;
    color: var(--gold-light);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }
  .page-hero h1 {
    color: #fff;
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    margin: 14px 0 16px;
    letter-spacing: .01em;
  }
  .page-hero p {
    max-width: 700px;
    color: rgba(255,255,255,.78);
    font-size: 16px;
    line-height: 1.95;
  }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .page-hero__actions:empty { display: none; }

  @media (max-width: 768px) {
    .page-hero { padding: 42px 0 52px; }
    .page-hero p { font-size: 15px; }
    .page-hero__shade { background: linear-gradient(90deg, rgba(10,29,54,.9), rgba(10,29,54,.72)); }
  }
</style>
