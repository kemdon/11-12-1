---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { news, site } from '../data/site';

const columns = [
  {
    tag: '媒体聚焦',
    title: '公开报道中的商盛源',
    body: '大河报、中国企业家杂志等媒体对胖东来游学现象与商盛源的报道记录。',
    icon: '01',
  },
  {
    tag: '研学交流',
    title: '真智慧 · 真实用 · 真成效',
    body: '游学交流会把学习成果放到台面上复盘，让转化被看见、被讨论。',
    icon: '02',
  },
  {
    tag: '课程动态',
    title: '从看见到落地的产品演进',
    body: '从游学课到落地课、进阶课、主题课，课程体系随企业需求持续打磨。',
    icon: '03',
  },
];
---

<Layout title="研学动态" description="商盛源研学动态：公开媒体报道、胖东来游学交流会与课程体系演进记录。">

  <PageHero
    kicker="NEWS & UPDATES"
    title="研学动态：把走过的路留成记录"
    body="媒体报道、行业交流与企业学习现场的动态，记录了商盛源从「看见文化的力量」到「文化就是生产力」的过程。"
    crumb="研学动态"
    image="/images/case-conference.webp"
  >
    <a class="btn btn--gold" href="/contact">联系课程助教 →</a>
    <a class="btn btn--outline" href="/guide">查看研学指南</a>
  </PageHero>

  <!-- 动态分类 -->
  <section class="section">
    <div class="container">
      <SectionHead kicker="WHAT'S HAPPENING" title="动态关注三个方向" body="从外部报道，到现场交流，再到课程本身的产品演进。" />
      <div class="grid grid--3">
        {columns.map((c) => (
          <article class="column-card reveal">
            <span class="num">{c.icon}</span>
            <span class="tag">{c.tag}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 动态列表 -->
  <section class="section section--warm" id="list">
    <div class="container">
      <SectionHead kicker="TIMELINE" title="媒体报道与行业记录" body="以下为公开资料中可查的记录，按发布时间整理。" />
      <div class="news-list">
        {news.map((item, i) => (
          <article class="news-row reveal">
            <div class="news-row__date">
              <span class="num">{item.date}</span>
              <span class="tag tag--blue">{item.source}</span>
            </div>
            <div class="news-row__body">
              <span class="news-row__no num">0{i + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="source-note">{site.sourceNote}；具体业务信息以课程助教确认为准。</p>
    </div>
  </section>

  <CtaBand title="想了解最近的研学安排？" body="关注微信公众号「商盛源」后台留言，或联系课程助教沟通团队需求与近期班期。" secondaryLabel="查看课程排期" secondaryHref="/schedule" />
</Layout>

<style>
  .column-card { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 32px 28px 34px; overflow: hidden; }
  .column-card .num { position: absolute; right: 24px; top: 18px; font-size: 44px; color: var(--gold-pale); line-height: 1; }
  .column-card h3 { font-size: 20px; margin: 18px 0 10px; }
  .column-card p { font-size: 14.5px; line-height: 1.9; }

  .news-list { display: grid; gap: 16px; }
  .news-row { display: grid; grid-template-columns: 190px 1fr; gap: 28px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 30px 32px; transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .news-row:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .news-row__date { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; border-right: 1px solid var(--line); }
  .news-row__date .num { font-size: 24px; color: var(--gold-deep); }
  .news-row__body { display: grid; grid-template-columns: 44px 1fr; column-gap: 14px; }
  .news-row__no { grid-row: 1 / 3; font-size: 30px; color: var(--gold-deep); line-height: 1.2; }
  .news-row h3 { font-size: 19px; line-height: 1.6; margin-bottom: 10px; }
  .news-row p { font-size: 14.5px; line-height: 1.9; }
  .source-note { text-align: center; margin-top: 30px; font-size: 12.5px; color: var(--ink-3); }

  @media (max-width: 768px) {
    .news-row { grid-template-columns: minmax(0, 1fr); gap: 18px; padding: 24px 22px; }
    .news-row__date { flex-direction: row; align-items: center; border-right: 0; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
    .news-row__body { grid-template-columns: minmax(0, 1fr); }
    .news-row__no { display: none; }
  }
</style>
