---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { scheduleNotes, consultSteps, courseTracks } from '../data/site';

const prepare = [
  '团队人数与岗位构成（老板、高管、店长、运营各多少人）',
  '所属行业与当前经营阶段',
  '本次最想解决的一个具体问题',
  '希望重点覆盖的主题：服务、客诉、标准化或文化机制',
  '可出行的时间范围与偏好',
];
---

<Layout title="课程排期" description="商盛源课程排期与班期咨询：具体开班时间、地点与费用以课程助教确认为准，官网不发布未经确认的排期。">

  <PageHero
    kicker="SCHEDULE & ENROLLMENT"
    title="课程排期：先确认目标，再确认班期"
    body="课程按团队目标与班型滚动安排。具体开班时间、地点、费用与行程明细，由课程助教在沟通需求后确认。"
    crumb="课程排期"
    image="/images/guide-desk.webp"
  >
    <a class="btn btn--gold" href="/contact">咨询班期 →</a>
    <a class="btn btn--outline" href="/courses">查看课程中心</a>
  </PageHero>

  <!-- 排期说明 -->
  <section class="section">
    <div class="container">
      <SectionHead kicker="HOW SCHEDULING WORKS" title="关于班期，我们先说清楚三件事" body="不发布未经确认的排期，是对团队行程负责。" />
      <div class="grid grid--3">
        {scheduleNotes.map((n, i) => (
          <article class="note-card reveal">
            <span class="note-card__no num">0{i + 1}</span>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 从咨询到成行 -->
  <section class="section section--warm">
    <div class="container">
      <SectionHead kicker="FOUR STEPS" title="从咨询到成行" body="把目标说清楚，剩下的匹配工作交给我们。" />
      <div class="steps-grid">
        {consultSteps.map((s) => (
          <article class="step-card reveal">
            <div class="step-card__no num">{s.no}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 按阶段选课 -->
  <section class="section">
    <div class="container">
      <div class="match-grid">
        <div class="match-text reveal">
          <SectionHead kicker="MATCH A TRACK" title="按学习阶段，先选课程类型" align="left" />
          <p class="lead">班期跟着课程走，课程跟着目标走。先确定团队处在哪个阶段，再和助教确认可参加的班期。</p>
          <div class="match-list">
            {courseTracks.map((t, i) => (
              <div class="match-item"><span class="num">0{i + 1}</span><strong>{t.name}</strong><p>{t.desc}</p></div>
            ))}
          </div>
          <a class="btn btn--navy" href="/courses">查看完整课程介绍 →</a>
        </div>
        <div class="match-media reveal">
          <img src="/images/course-hall.webp" alt="布置整齐的中型培训教室" loading="lazy" />
          <div class="match-card">
            <strong>咨询时请准备</strong>
            <ul>{prepare.map((p) => <li>{p}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="把团队情况发给我们，先判断适合哪个班型" body="关注微信公众号「商盛源」后台留言，或联系课程助教沟通团队需求。" primaryLabel="沟通团队需求" secondaryLabel="查看研学指南" secondaryHref="/guide" />
</Layout>

<style>
  .note-card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--gold); border-radius: var(--radius-lg); padding: 32px 28px 34px; }
  .note-card__no { display: block; font-size: 34px; color: var(--gold-light); line-height: 1; margin-bottom: 16px; }
  .note-card h3 { font-size: 20px; margin-bottom: 12px; }
  .note-card p { font-size: 14.5px; line-height: 1.95; }

  .steps-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; position: relative; }
  .steps-grid::before { content: ""; position: absolute; top: 34px; left: 8%; right: 8%; height: 1px; background: linear-gradient(90deg, transparent, var(--gold) 12%, var(--gold) 88%, transparent); }
  .step-card { position: relative; padding: 0 8px; }
  .step-card__no { position: relative; z-index: 1; width: 68px; height: 68px; display: grid; place-items: center; margin-bottom: 22px; background: #fff; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold-deep); font-size: 22px; box-shadow: 0 0 0 8px var(--paper-warm); }
  .step-card h3 { font-size: 18.5px; margin-bottom: 10px; }
  .step-card p { font-size: 14px; line-height: 1.9; }

  .match-grid { display: grid; grid-template-columns: 1fr .95fr; gap: 64px; align-items: start; }
  .match-text :global(.section-head) { margin-bottom: 20px; }
  .match-list { margin: 24px 0 30px; }
  .match-item { display: grid; grid-template-columns: 40px 92px 1fr; gap: 14px; align-items: baseline; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .match-item > span { color: var(--gold-deep); font-size: 20px; }
  .match-item strong { color: var(--navy-900); font-size: 16px; }
  .match-item p { font-size: 13.8px; line-height: 1.8; }
  .match-media { position: relative; padding-bottom: 40px; }
  .match-media > img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  .match-card { position: absolute; left: -24px; bottom: 0; width: min(340px, 88%); background: #fff; border-left: 4px solid var(--gold); border-radius: 0 var(--radius) var(--radius) 0; padding: 22px 24px; box-shadow: var(--shadow-md); }
  .match-card strong { display: block; color: var(--navy-900); font-size: 16px; margin-bottom: 12px; }
  .match-card li { position: relative; padding-left: 16px; margin-bottom: 9px; font-size: 13px; line-height: 1.7; color: var(--ink-2); }
  .match-card li::before { content: ""; position: absolute; left: 0; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }

  @media (max-width: 1024px) {
    .steps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px; }
    .steps-grid::before { display: none; }
    .match-grid { gap: 40px; }
  }
  @media (max-width: 900px) {
    .match-grid { grid-template-columns: minmax(0, 1fr); gap: 56px; }
    .match-media { max-width: 620px; }
  }
  @media (max-width: 600px) {
    .steps-grid { grid-template-columns: minmax(0, 1fr); }
    .match-card { left: 12px; width: calc(100% - 24px); }
    .match-item { grid-template-columns: 34px 1fr; }
    .match-item p { grid-column: 2; }
  }
</style>
