---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  site, stats, serviceTypes, painPoints, methods, loopSteps, paths, courses,
  cases, voices, timeline, news, guides, faq, teacherRoles,
} from '../data/site';
---

<Layout title="" description={`${site.name}｜${site.description}`}>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <img class="hero__img" src="/images/hero.webp" alt="企业参访者在卖场生鲜区观察服务细节" fetchpriority="high" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">{site.fullName} · {site.group}</span>
        <h1>真落地，<br /><em>才是真游学</em></h1>
        <p class="hero__lead">
          看见文化的力量，把文化变成生产力。<br />
          自 2016 年启动胖东来游学项目，我们陪企业带着问题到现场，把方法带回团队。
        </p>
        <div class="hero__actions">
          <a class="btn btn--gold" href="/contact">沟通团队需求 →</a>
          <a class="btn btn--outline" href="/yanxue">了解胖东来研学</a>
        </div>
        <div class="hero__chips">
          <span>胖东来研学项目缔造企业</span>
          <span>12450 家企业 · 87056 人走进胖东来</span>
          <span>探店四步骤 · 四步反省法 · 落地四步曲</span>
        </div>
      </div>
    </div>
    <div class="hero__corner" aria-hidden="true">
      <span class="num">2016</span>
      <small>胖东来游学项目启动</small>
    </div>
    <div class="hero__scroll" aria-hidden="true"><span></span>SCROLL</div>
  </section>

  <!-- ============ DATA PROOF ============ -->
  <section class="stats">
    <div class="container">
      <div class="stats__grid">
        {stats.map((item) => (
          <div class="stat reveal">
            <div class="stat__value num">{item.value}</div>
            <div class="stat__label">{item.label}</div>
            <div class="stat__detail">{item.detail}</div>
          </div>
        ))}
      </div>
      <div class="service-strip">
        <span class="service-strip__label">服务类型</span>
        {serviceTypes.map((t) => <span class="service-strip__item">{t}</span>)}
      </div>
      <p class="stats__note">数据口径：截至 2026 年 10 月底，商盛源累计带领 12450 家企业、87056 人走进胖东来学习。</p>
    </div>
  </section>

  <!-- ============ 企业介绍 ============ -->
  <section class="section intro-sec">
    <div class="container">
      <div class="intro__grid">
        <div class="intro__media reveal">
          <img src="/images/intro.webp" alt="明亮的企业会议室内摆放着资料与笔记本" loading="lazy" />
          <div class="intro__badge">
            <strong>{site.name}</strong>
            <span>{site.slogan}</span>
          </div>
        </div>
        <div class="intro__text reveal">
          <SectionHead
            kicker="ABOUT SHANGSHENGYUAN"
            title="看见文化的力量，更要让文化落下来"
            align="left"
          />
          <p class="lead">{site.description}</p>
          <p class="intro__para">
            2015 年因爱聚焦胖东来，2016 年启动胖东来游学项目。近 10 年来边传播、边学习、边转化，
            从「游」到「学」，再到聚焦「落地」，逐步沉淀出自有方法体系与完整的课程闭环。
          </p>
          <div class="intro__points">
            <div class="intro__point">
              <span class="num">01</span>
              <div><strong>首家组织胖东来游学</strong><p>率先提出「看见文化的力量」经营理念</p></div>
            </div>
            <div class="intro__point">
              <span class="num">02</span>
              <div><strong>聚焦落地的课程闭环</strong><p>游学课、落地课、进阶课、主题课按阶段匹配</p></div>
            </div>
            <div class="intro__point">
              <span class="num">03</span>
              <div><strong>课后持续陪跑</strong><p>每周三线上辅导课与入企辅导接续推进</p></div>
            </div>
          </div>
          <a class="btn btn--navy" href="/about">了解商盛源 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 经营痛点 ============ -->
  <section class="section section--warm pain-sec">
    <div class="container">
      <SectionHead
        kicker="WHY LANDING MATTERS"
        title="为什么很多企业学完，还是没有变化？"
        body="「真落地」的提出，来自近 10 年陪伴企业转化时反复遇到的三类经营痛点。"
      />
      <div class="grid grid--3">
        {painPoints.map((item) => (
          <article class="pain-card reveal">
            <div class="pain-card__no num">{item.no}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <div class="pain-card__line"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 研学闭环 ============ -->
  <section class="section loop-sec">
    <div class="container">
      <SectionHead
        kicker="LEARNING LOOP"
        title="带着问题到现场，把方法带回团队"
        body="先明确要解决的问题，再到许昌现场验证方法，最后沉淀为回去能执行的行动清单。"
      />
      <div class="loop__grid">
        {loopSteps.map((step) => (
          <article class="loop-step reveal">
            <div class="loop-step__no num">{step.no}</div>
            <span class="loop-step__phase">{step.phase}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
      <div class="loop__foot reveal">
        <span>方法体系</span>
        {methods.map((m) => <em>{m.name}</em>)}
        <a class="text-link" href="/yanxue">查看完整研学流程 →</a>
      </div>
    </div>
  </section>

  <!-- ============ 两种学习方式 ============ -->
  <section class="section section--blue paths-sec">
    <div class="container">
      <SectionHead
        kicker="CHOOSE YOUR PATH"
        title="根据团队目标选择学习方式"
        body="系统研学和现场考察分别承接不同阶段的学习目标，先判断适合什么，再决定怎么出发。"
      />
      <div class="paths__grid">
        {paths.map((item) => (
          <article class="path-card reveal">
            <div class="path-card__media">
              <img src={item.image} alt={item.alt} loading="lazy" />
            </div>
            <div class="path-card__body">
              <span class="tag">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul>
                {item.points.map((p) => <li>{p}</li>)}
              </ul>
              <a class="text-link" href={item.href}>查看方案 →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 方法体系 ============ -->
  <section class="section method-sec">
    <div class="container">
      <div class="method__grid">
        <div class="method__text reveal">
          <SectionHead
            kicker="OUR METHOD"
            title="把现场所见，拆成能执行的动作"
            align="left"
          />
          <p class="lead">近 10 年边传播、边学习、边转化，形成的不是一句口号，而是三个可以反复使用的方法。</p>
          <div class="method__list">
            {methods.map((m, i) => (
              <div class="method__item">
                <div class="method__no num">0{i + 1}</div>
                <div><h3>{m.name}</h3><p>{m.body}</p></div>
              </div>
            ))}
          </div>
          <a class="btn btn--navy" href="/courses">查看课程中心 →</a>
        </div>
        <div class="method__media reveal">
          <img src="/images/workshop.webp" alt="企业管理者围坐长桌做复盘共创，桌面有便签与资料" loading="lazy" />
          <div class="method__caption">从现场取证，到团队行动共创</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 课程选择 ============ -->
  <section class="section section--warm courses-sec">
    <div class="container">
      <div class="split-head">
        <SectionHead
          kicker="COURSES"
          title="按团队问题选择课程"
          body="围绕服务标准、客诉处理、文化机制与组织复盘，匹配当前最需要解决的主题。"
          align="left"
        />
        <a class="btn btn--line btn--sm" href="/courses">查看全部课程 →</a>
      </div>
      <div class="grid grid--3">
        {courses.slice(0, 3).map((course) => (
          <article class="card reveal">
            <div class="card__media"><img src={course.image} alt={course.alt} loading="lazy" /></div>
            <div class="card__body">
              <span class="tag tag--blue">{course.type}</span>
              <h3>{course.title}</h3>
              <p>{course.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 企业案例 ============ -->
  <section class="section cases-sec">
    <div class="container">
      <div class="split-head">
        <SectionHead
          kicker="LEARNING WITNESS"
          title="他们曾带着问题来到现场"
          body="以下为商盛源公开简介中记载的学习见证，可结合相近团队的路径规划自己的研学安排。"
          align="left"
        />
        <a class="btn btn--line btn--sm" href="/cases">查看案例与师资 →</a>
      </div>
      <div class="grid grid--3">
        {cases.map((item) => (
          <article class="card case-card reveal">
            <div class="card__media"><img src={item.image} alt={item.alt} loading="lazy" /></div>
            <div class="card__body">
              <div class="case-card__top"><span class="num">{item.no}</span><span class="tag">{item.metric}</span></div>
              <h3>{item.name}</h3>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 查看讲师 ============ -->
  <section class="section section--blue teacher-sec">
    <div class="container">
      <div class="split-head">
        <SectionHead
          kicker="YOUR FACULTY"
          title="先看讲师怎么带，再决定怎么学"
          body="授课、现场带看、落地带练与会务保障共同完成一次研学；讲师身份与课程分工在咨询时确认。"
          align="left"
        />
        <a class="btn btn--line btn--sm" href="/teachers">查看讲师团队 →</a>
      </div>
      <div class="grid grid--4">
        {teacherRoles.map((r, i) => (
          <article class="teacher-mini reveal">
            <span class="num">0{i + 1}</span>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 学习感悟 ============ -->
  <section class="section section--navy voices-sec">
    <div class="container">
      <SectionHead
        kicker="VOICES"
        title="幸福见证：他们从现场带走了什么"
        body="摘自商盛源公众号公开的学习感悟，署名按原文匿名处理。"
      />
      <div class="grid grid--3">
        {voices.map((v) => (
          <blockquote class="voice-card reveal">
            <span class="voice-card__mark">“</span>
            <p>{v.text}</p>
            <cite>{v.from}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 发展历程 ============ -->
  <section class="section timeline-sec">
    <div class="container">
      <SectionHead kicker="OUR JOURNEY" title="近 10 年，从看见到落地" body="文化就是生产力，落地才是真游学。" />
      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline__row reveal">
            <div class="timeline__year num">{item.year}</div>
            <div class="timeline__dot" aria-hidden="true"></div>
            <div class="timeline__content">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 最近动态 ============ -->
  <section class="section section--blue news-sec">
    <div class="container">
      <div class="split-head">
        <SectionHead kicker="IN THE NEWS" title="媒体报道与行业评价" body="公开报道中关于商盛源与胖东来游学的记录。" align="left" />
        <a class="btn btn--line btn--sm" href="/news">查看研学动态 →</a>
      </div>
      <div class="grid grid--3">
        {news.map((item) => (
          <article class="news-card reveal">
            <div class="news-card__meta"><span class="num">{item.date}</span><span class="tag tag--blue">{item.source}</span></div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 研学指南 ============ -->
  <section class="section guides-sec">
    <div class="container">
      <SectionHead kicker="BEFORE YOU GO" title="出发前先看，别让研学停在「看过」" body="围绕研学路径、服务机制、文化管理与行业转化，先形成更清晰的学习判断。" />
      <div class="guides__list">
        {guides.map((g) => (
          <a class="guide-row reveal" href="/guide">
            <span class="guide-row__no num">{g.no}</span>
            <span class="guide-row__tag">{g.tag}</span>
            <div class="guide-row__text"><h3>{g.title}</h3><p>{g.body}</p></div>
            <span class="guide-row__arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section section--warm faq-sec">
    <div class="container">
      <SectionHead kicker="FAQ" title="报名前，先了解这些" body="关于商盛源、课程内容、适合团队与报名方式的常见问题。" />
      <div class="faq__list">
        {faq.slice(0, 6).map((item, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary><span class="faq-item__no num">{String(i + 1).padStart(2, '0')}</span><span>{item.q}</span><span class="faq-item__icon" aria-hidden="true"></span></summary>
            <div class="faq-item__answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
      <div class="faq__more"><a class="text-link" href="/guide">查看完整研学指南 →</a></div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 660px;
    overflow: hidden;
    background: #5a2408;
  }
  .hero__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 62% center;
    animation: heroFade 1.5s ease-out both;
  }
  @keyframes heroFade { from { opacity: 0; transform: scale(1.04); } to { opacity: 1; transform: scale(1); } }
  .hero__shade {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(90,36,8,.94) 0%, rgba(90,36,8,.82) 38%, rgba(90,36,8,.42) 72%, rgba(90,36,8,.24) 100%);
  }
  .hero__inner { position: relative; z-index: 1; padding-top: 84px; padding-bottom: 92px; }
  .hero__content { max-width: 680px; }
  .hero__eyebrow {
    display: inline-block;
    padding-left: 14px;
    border-left: 2px solid var(--gold);
    color: var(--gold-light);
    font-size: 13px;
    letter-spacing: .1em;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.7rem, 5.6vw, 4.4rem);
    line-height: 1.24;
    margin: 22px 0 22px;
    letter-spacing: .02em;
    text-shadow: 0 2px 24px rgba(0,0,0,.2);
  }
  .hero h1 em { font-style: normal; color: var(--gold-light); }
  .hero__lead { color: rgba(255,255,255,.84); font-size: 17px; line-height: 2; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero__chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }
  .hero__chips span {
    padding: 7px 15px;
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 100px;
    color: rgba(255,255,255,.8);
    font-size: 12.5px;
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(4px);
  }
  .hero__corner {
    position: absolute; right: 34px; bottom: 40px; z-index: 1;
    display: flex; flex-direction: column; align-items: flex-end;
    color: #fff; text-align: right;
  }
  .hero__corner .num { font-size: 40px; color: var(--gold-light); line-height: 1; }
  .hero__corner small { font-size: 11px; letter-spacing: .12em; color: rgba(255,255,255,.7); margin-top: 8px; }
  .hero__scroll {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 1;
    display: flex; align-items: center; gap: 10px;
    color: rgba(255,255,255,.55); font-size: 10px; letter-spacing: .24em;
  }
  .hero__scroll span { display: block; width: 34px; height: 1px; background: rgba(255,255,255,.45); }

  /* ---------- Stats ---------- */
  .stats {
    background: linear-gradient(120deg, #5a2408 0%, #9c3f10 55%, #c2561a 100%);
    padding: 52px 0 30px;
    border-bottom: 3px solid var(--gold);
  }
  .stats__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .stat { padding: 4px 28px; border-left: 1px solid rgba(255,255,255,.16); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat__value { color: var(--gold-light); font-size: clamp(2rem, 3.4vw, 2.85rem); line-height: 1.1; }
  .stat__label { color: #fff; font-size: 14.5px; font-weight: 600; margin-top: 10px; }
  .stat__detail { color: rgba(255,255,255,.55); font-size: 12.5px; margin-top: 4px; line-height: 1.7; }
  .stats__note { text-align: right; color: rgba(255,255,255,.42); font-size: 11.5px; margin-top: 12px; }
  .service-strip {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    margin-top: 26px; padding: 16px 20px;
    background: rgba(255,255,255,.07); border: 1px solid rgba(229,119,40,.3); border-radius: var(--radius);
  }
  .service-strip__label { color: var(--gold-light); font-size: 13px; font-weight: 700; margin-right: 4px; }
  .service-strip__item { padding: 5px 14px; border-radius: 100px; background: rgba(255,255,255,.1); color: #fff; font-size: 13px; }

  /* ---------- Intro ---------- */
  .intro__grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: 72px; align-items: center; }
  .intro__media { position: relative; padding-bottom: 26px; }
  .intro__media img {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .intro__badge {
    position: absolute; left: -26px; bottom: 0;
    display: flex; flex-direction: column; gap: 4px;
    background: #fff; padding: 18px 26px;
    border-left: 4px solid var(--gold);
    border-radius: 0 var(--radius) var(--radius) 0;
    box-shadow: var(--shadow-md);
  }
  .intro__badge strong { font-size: 20px; color: var(--navy-900); letter-spacing: .1em; }
  .intro__badge span { font-size: 12px; color: var(--gold-deep); }
  .intro__text :global(.section-head) { margin-bottom: 24px; }
  .intro__para { margin-top: 16px; font-size: 15.5px; line-height: 2; color: var(--ink-2); }
  .intro__points { display: grid; gap: 16px; margin: 28px 0 32px; }
  .intro__point { display: flex; gap: 16px; align-items: flex-start; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .intro__point:last-child { border-bottom: 0; padding-bottom: 0; }
  .intro__point > span { color: var(--gold-deep); font-size: 21px; line-height: 1.3; flex: none; }
  .intro__point strong { display: block; color: var(--navy-900); font-size: 15.5px; margin-bottom: 3px; }
  .intro__point p { font-size: 13.5px; line-height: 1.7; }

  /* ---------- Pain ---------- */
  .pain-card {
    position: relative;
    background: #fff;
    padding: 34px 30px 36px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease);
  }
  .pain-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .pain-card__no { font-size: 44px; color: var(--gold-light); line-height: 1; margin-bottom: 18px; }
  .pain-card h3 { font-size: 20px; margin-bottom: 12px; }
  .pain-card p { font-size: 14.5px; line-height: 1.9; }
  .pain-card__line { position: absolute; left: 0; top: 0; width: 4px; height: 100%; background: linear-gradient(180deg, var(--gold), var(--gold-pale)); }

  /* ---------- Loop ---------- */
  .loop__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 26px; position: relative; }
  .loop__grid::before {
    content: ""; position: absolute; top: 31px; left: 8%; right: 8%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold) 12%, var(--gold) 88%, transparent);
  }
  .loop-step { position: relative; }
  .loop-step__no {
    position: relative; z-index: 1;
    width: 62px; height: 62px; border-radius: 50%;
    display: grid; place-items: center;
    background: #fff; border: 1px solid var(--gold);
    color: var(--gold-deep); font-size: 21px;
